# Port the site serves on. Read from here or from the shell (the shell wins).
PORT=5174

# The Moria API, as this app's server reaches it. Every catalogue request is
# made server-side, so the browser never calls the API and no CORS entry is
# needed. May be an internal address when deployed.
MORIA_API_URL=http://localhost:4800/api/v1

# The site's own public address — used for canonical links, the sitemap and
# social previews.
SITE_URL=http://localhost:5174

# Extra hosts product covers may come from, comma-separated — e.g. a custom
# CDN domain in front of the Spaces bucket. *.digitaloceanspaces.com is
# always allowed.
MORIA_IMAGE_HOSTS=

# Shared secret for POST /api/revalidate, which the API calls after every
# product or category change so it shows at once. Must equal the API's
# PUBLIC_SITE_REVALIDATE_SECRET. Blank turns the endpoint off; the catalogue
# then refreshes on its five-minute cache alone.
REVALIDATE_SECRET=

# true makes the browser load product covers straight from Spaces, skipping
# Next's image optimizer, which gives each original only 7 s to download. For
# local development on a slow connection; leave unset when deployed.
MORIA_IMAGES_UNOPTIMIZED=

# Contact details for the footer. Each shows only when set; leave any blank
# to hide it. Phone numbers may be local ("024 400 0000") or international
# ("+233 24 400 0000"); social handles may include the "@".
MORIA_CONTACT_PHONE=
MORIA_CONTACT_EMAIL=
MORIA_WHATSAPP=
MORIA_INSTAGRAM=
MORIA_TIKTOK=
MORIA_SNAPCHAT=
