# Port the site serves on. Read from here or from the shell (the shell wins).
PORT=5174

# The Moria API, as this app's server reaches it. Every catalogue request is
# made server-side, so the browser never calls the API and no CORS entry is
# needed. May be an internal address when deployed.
MORIA_API_URL=http://localhost:4800/api/v1

# The site's own public address — used for canonical links, the sitemap and
# social previews.
SITE_URL=http://localhost:5174

# Extra hosts product covers may come from, comma-separated — e.g. a custom
# CDN domain in front of the Spaces bucket. *.digitaloceanspaces.com is
# always allowed.
MORIA_IMAGE_HOSTS=
